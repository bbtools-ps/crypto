{
  "name": "crypto",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "react-router typegen && tsc && oxlint --deny-warnings && vitest run",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest --reporter=verbose",
    "generate": "cd emoji-dict && npx rimraf dist && npx tsc && npx copyfiles full-emoji-list.json dist && cd dist && node app.js  && cd .. && npx rimraf dist",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.2.1",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.3",
    "isbot": "^5.1.17",
    "lucide-react": "^0.469.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "vite-plugin-babel": "^1.3.2"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "copyfiles": "^2.4.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.6",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^6.0.3",
    "vite": "^7",
    "vitest": "^4.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
